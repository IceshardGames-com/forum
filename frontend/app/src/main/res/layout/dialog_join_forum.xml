<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/join_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_discussion"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">
        <!-- Header -->
        <TextView
            android:id="@+id/join_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titilliumweb_bold"
            android:gravity="center"
            android:text="Join Forum"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <!-- Instruction -->
        <TextView
            android:id="@+id/join_dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/titilliumweb_raguler"
            android:text="Enter the forum slug or invite code to join an existing community."
            android:textColor="@color/light_gray"
            android:textSize="10sp" />

        <!-- Input field row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="@dimen/_5sdp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ic_join_input"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="join icon"
                android:src="@drawable/join_forum"
                android:tint="@color/gradient_end" />

            <EditText
                android:id="@+id/input_join_slug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/input_field_background_purple"
                android:hint="forum-slug or invite-code"
                android:imeOptions="actionDone"
                android:fontFamily="@font/titilliumweb_semibold"
                android:singleLine="true"
                android:textSize="12dp"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/join_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@android:color/holo_red_light"
            android:textSize="10sp"
            android:visibility="gone" />


        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_join_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/titilliumweb_bold"
                android:padding="10dp"
                android:text="Cancel"
                android:textColor="@color/white" />


            <TextView
                android:id="@+id/btn_join_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/titilliumweb_bold"
                android:paddingLeft="16dp"
                android:paddingVertical="@dimen/_5sdp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingRight="16dp"
                android:background="@drawable/button_round_background_curve"
                android:text="Join" />

        </LinearLayout>

        <!-- Small progress indicator (hidden by default) -->
        <ProgressBar
            android:id="@+id/join_progress"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Small"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
