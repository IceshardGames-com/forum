<!-- res/layout/item_channel.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:padding="@dimen/_15sdp"
    android:background="@drawable/bg_gradient_discussion"
    android:layout_gravity="center"
    android:gravity="center"
    android:clipToPadding="false"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="8dp"
    android:layout_marginRight="8dp"
    android:elevation="4dp">


    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center"
        android:clipToOutline="true"
        card_view:cardCornerRadius="50dp">

        <ImageView
            android:id="@+id/channel_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_slider1" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FPS Gaming"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/titilliumweb_semibold" />

    <TextView
        android:id="@+id/channel_user_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="345 Users"
        android:textSize="10sp"
        android:textColor="#aaaaaa" />

    <TextView
        android:id="@+id/join_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:padding="10dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/button_round_background"
        android:textColor="@android:color/white"
        android:minWidth="64dp"/>
</LinearLayout>
