<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/border"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <EditText
            android:id="@+id/inputChatName"
            android:hint="Enter username"
            android:layout_width="match_parent"
            android:background="@drawable/input_field_background_purple"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="12dp"
            android:fontFamily="@font/titilliumweb_semibold"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/btnCancels"
                android:text="Cancel"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/titilliumweb_bold"
                android:background="@drawable/category_button_selected"
                android:layout_width="match_parent"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/btnStart"
                android:text="Start"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/titilliumweb_bold"
                android:background="@drawable/category_button_selected"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>
