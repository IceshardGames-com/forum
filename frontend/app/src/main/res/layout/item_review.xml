<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gradient_companynews"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reviewUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VRMaster"
            android:textSize="16dp"
            android:textColor="@color/darkgpurple"
            android:fontFamily="@font/titilliumweb_bold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reviewTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2 days ago"
            android:textColor="#AAAAAA"
            android:textSize="10dp"
            android:fontFamily="@font/titilliumweb_raguler"
            android:layout_gravity="end|center_vertical|bottom"
            android:gravity="end|center_vertical|bottom"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/reviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amazing VR Experience!"
        android:textColor="#F5F5F5"
        android:textSize="13sp"
        android:fontFamily=""
        android:textStyle="bold"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/reviewDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This game completely blew me away..."
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:fontFamily="@font/titilliumweb_raguler"
        android:layout_marginTop="2dp"/>

    <RatingBar
        android:id="@+id/reviewRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:rating="4.5"
        android:stepSize="0.5"
        android:isIndicator="true"
        android:layout_marginTop="6dp"
        style="@style/Widget.AppCompat.RatingBar.Small"/>
</LinearLayout>
