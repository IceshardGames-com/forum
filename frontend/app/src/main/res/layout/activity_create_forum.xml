<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layout_gravity="center"
    android:fillViewport="true"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/border"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:padding="@dimen/_10sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/close"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/cancel"
                android:tint="@color/middle" />

            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:fontFamily="@font/header"
                android:text="Create New Forum"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sdp" />


        </RelativeLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="Forum Title"
            android:textColor="@color/middle"
            android:textSize="@dimen/_12sdp" />

        <EditText
            android:id="@+id/editForumTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/input_field_background_purple"
            android:fontFamily="@font/titilliumweb_semibold"
            android:hint="Enter forum title"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="Description"
            android:textColor="@color/middle"
            android:textSize="@dimen/_12sdp" />

        <EditText
            android:id="@+id/editForumDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/input_field_background_purple"
            android:fontFamily="@font/titilliumweb_semibold"
            android:gravity="top"
            android:hint="Describe your forum..."
            android:maxLines="8"
            android:minLines="4"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/texthint"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/charCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fontFamily="@font/titilliumweb_raguler"
            android:text="0/500 characters"
            android:textColor="#999999"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="Category"
            android:textColor="@color/middle"
            android:textSize="@dimen/_12sdp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/input_field_background_purple"
            android:paddingVertical="@dimen/_5sdp"
            android:popupBackground="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="Post Permission"
            android:textColor="@color/middle"
            android:textSize="@dimen/_12sdp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/permissionToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminOnly"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@drawable/toggle_button_bg"
                android:fontFamily="@font/titilliumweb_semibold"
                android:text="Admin Only"
                android:textAllCaps="false"
                android:textColor="@color/toggle_button_text"
                app:cornerRadius="12dp"
                android:textSize="12dp"
                app:strokeColor="@color/darkgpurple"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFollowers"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@drawable/toggle_button_bg"
                android:fontFamily="@font/titilliumweb_semibold"
                android:text="Followers"
                android:textAllCaps="false"
                android:textColor="@color/toggle_button_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/darkgpurple"
                android:textSize="12dp"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMembers"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@drawable/toggle_button_bg"
                android:fontFamily="@font/titilliumweb_semibold"
                android:text="Members"
                android:textAllCaps="false"
                android:textSize="12dp"
                android:textColor="@color/toggle_button_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/darkgpurple"
                app:strokeWidth="1dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <CheckBox
            android:id="@+id/checkboxPrivateForum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titilliumweb_raguler"
            android:paddingVertical="@dimen/_10sdp"
            android:text="Private Forum"
            android:textColor="@color/darkgpurple"
            android:textSize="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/button_round_background_curve"
                android:backgroundTint="#444444"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/titilliumweb_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="Cancel"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnCreateForum"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="@dimen/_12sdp"

                android:gravity="center"
                android:layout_weight="1"
                android:background="@drawable/button_round_background_curve"
                android:fontFamily="@font/titilliumweb_bold"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="Create Forum"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
