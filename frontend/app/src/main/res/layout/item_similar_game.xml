<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_discussion"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            card_view:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/imageGameIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/forum1" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="Game Name"
            android:textColor="@color/darkgpurple"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textGameRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/titilliumweb_bold"
            android:text="4.8"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
