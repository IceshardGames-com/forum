<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginHorizontal="8dp"
    android:background="@drawable/bg_gradient_discussion"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Rank -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/bg_rank_circle"
        android:gravity="center"
        android:fontFamily="@font/titilliumweb_bold"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginStart="12dp"
        android:clipToOutline="true"
        android:padding="2dp"
        card_view:cardCornerRadius="50dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_mask"
            android:scaleType="centerCrop"
            android:src="@drawable/img_slider1" />
    </androidx.cardview.widget.CardView>

    <!-- Team Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#fff"
            android:textSize="16sp"
            android:fontFamily="@font/titilliumweb_bold"/>

        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: 0"
            android:textColor="@color/gradient_end"
            android:fontFamily="@font/titilliumweb_raguler"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Wins & Losses -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W: 0"
            android:fontFamily="@font/titilliumweb_bold"
            android:textColor="#8BC34A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLosses"
            android:layout_width="wrap_content"
            android:fontFamily="@font/titilliumweb_bold"
            android:layout_height="wrap_content"
            android:text="L: 0"
            android:textColor="@color/middle"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
