<!-- res/layout/activity_chat_list.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blacktrans" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chat_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/tab_messages"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:layout_margin="2dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_threads"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Threads"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:layout_margin="2dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_unread"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:layout_margin="2dp"
                android:padding="10dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_requests"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/explore_channels_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:overScrollMode="never"
            tools:itemCount="1"
            tools:listitem="@layout/item_channel"
            android:orientation="horizontal"/>


        <EditText
            android:id="@+id/search_chat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_gradient_discussion"
            android:drawableStart="@drawable/searchi"
            android:drawablePadding="@dimen/_10sdp"
            android:layout_marginHorizontal="10dp"
            android:drawableTint="@color/gradient_end"
            android:hint="Search chats..."
            android:padding="12dp"
            android:fontFamily="@font/titilliumweb_semibold"
            android:textSize="@dimen/_12sdp"
            android:paddingStart="@dimen/_10sdp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />


        <!-- RecyclerView for Chat List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            tools:listitem="@layout/chat_item"
            android:layout_weight="1" />

        <!-- Floating Action Button -->

    </LinearLayout>
    <ImageView
        android:id="@+id/fab_new_chat"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:src="@drawable/plus"
        android:tint="@color/white"
        android:layout_margin="24dp"
        android:padding="@dimen/_15sdp"
        android:background="@drawable/button_round_background" />
</RelativeLayout>