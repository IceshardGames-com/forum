<!-- res/layout/activity_chat_list.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blacktrans" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/toper"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chat_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/tab_messages"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:layout_margin="2dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_threads"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Friends"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:layout_margin="2dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_unread"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_selector"
                android:layout_margin="2dp"
                android:padding="10dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>

            <TextView
                android:id="@+id/tab_requests"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:background="@drawable/tab_selector"
                android:padding="10dp"
                android:textSize="10dp"
                android:fontFamily="@font/titilliumweb_bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/friendRequestSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <!-- Friend Requests Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/friendRequestRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:scrollbars="none"/>

            <!-- 👇 Add this TextView -->
            <TextView
                android:id="@+id/tv_no_requests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="No new requests yet!"
                android:fontFamily="@font/titilliumweb_bold"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:padding="8dp"
                android:visibility="gone"/>

        </LinearLayout>


    </LinearLayout>

    <FrameLayout
        android:id="@+id/chat_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_below="@+id/toper"
        android:layout_marginBottom="4dp" />

    <ImageView
        android:id="@+id/fab_new_chat"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:src="@drawable/plus"
        android:tint="@color/white"
        android:layout_margin="24dp"
        android:visibility="gone"
        android:padding="@dimen/_15sdp"
        android:background="@drawable/button_round_background" />



</RelativeLayout>