<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgCommentUser"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/profilepic"
            android:background="@drawable/button_round_background"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvCommentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User"
            android:textColor="@color/white"
            android:fontFamily="@font/titilliumweb_bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="· 1h ago"
            android:layout_gravity="end"
            android:gravity="end"
            android:fontFamily="@font/titilliumweb_raguler"
            android:textColor="@color/light_gray"
            android:textSize="10sp"
            android:layout_marginStart="6dp" />


    </LinearLayout>

    <!-- Comment Text -->
    <TextView
        android:id="@+id/tvCommentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/titilliumweb_raguler"
        android:layout_marginStart="36dp"
        android:textColor="@color/light_gray"
        android:textSize="12sp"
        android:text="This looks amazing!" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginStart="36dp">

        <!-- Like -->
        <LinearLayout
            android:id="@+id/layoutCommentLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/imgCommentLike"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_like_outline" />

            <TextView
                android:id="@+id/tvCommentLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#B95D76"
                android:textSize="14sp"
                android:fontFamily="@font/titilliumweb_bold"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Dislike -->
        <LinearLayout
            android:id="@+id/layoutCommentDislike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/imgCommentDislike"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dislike_outline" />

            <TextView
                android:id="@+id/tvCommentDislikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#B95D76"
                android:textSize="14sp"
                android:fontFamily="@font/titilliumweb_bold"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Reply -->

        <LinearLayout
            android:id="@+id/layoutcomReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnCommentReply"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/comment"
                app:tint="#B95D76" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/titilliumweb_bold"
                android:text="Reply"
                android:textColor="#B95D76"
                android:textSize="12sp" />
        </LinearLayout>
        <!-- Share -->
        <LinearLayout
            android:id="@+id/layoutcomShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPostShare"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/share"
                app:tint="#B95D76" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/titilliumweb_bold"
                android:text="Share"
                android:textColor="#B95D76"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Reply Box (hidden by default) -->

    <LinearLayout
        android:id="@+id/layoutReplyBox"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/button_round_background"
            android:scaleType="centerCrop"
            android:src="@drawable/profilepic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_field_background_purple"
                android:fontFamily="@font/titilliumweb_semibold"
                android:gravity="top"
                android:hint="Write a reply..."
                android:maxLines="8"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/texthint"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/btnSendReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_round_background_curve"
                android:fontFamily="@font/titilliumweb_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:textSize="12dp"
                android:text="Send"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
